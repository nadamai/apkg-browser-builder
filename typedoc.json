{
	"$schema": "https://typedoc.org/schema.json",
	"plugin": ["typedoc-plugin-markdown"],
	"entryPoints": ["src/index.ts"],
	"out": "docs",
	"outputFileStrategy": "modules",
	"entryFileName": "docs.md",
	"name": "apkg-browser-builder",
	"includeVersion": true,
	"readme": "none",
	"hidePageHeader": true,
	"excludePrivate": true,
	"excludeProtected": true,
	"excludeInternal": true,
	"cleanOutputDir": true,
	"intentionallyNotExported": [
		"src/model/card.ts:Card",
		"src/model/collection.ts:Collection",
		"src/model/configuration.ts:Configuration",
		"src/model/deck.ts:Deck",
		"src/model/deck-config.ts:DeckConfiguration",
		"src/model/model.ts:Model",
		"src/model/note.ts:Note",
		"src/object/lapse-card-config.ts:LapseCardConfig",
		"src/object/new-card-config.ts:NewCardConfig",
		"src/object/review-card-config.ts:ReviewCardConfig",
		"src/object/field.ts:Field",
		"src/object/card-template.ts:CardTemplate"
	]
}
