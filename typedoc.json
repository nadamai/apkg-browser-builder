{
	"$schema": "https://typedoc.org/schema.json",
	"entryPoints": ["src/index.ts"],
	"excludeNotDocumented": true,
	"excludeNotDocumentedKinds": ["Constructor", "ConstructorSignature"],
	"excludeInternal": true,
	"excludeReferences": true,
	"excludeProtected": true,
	"readme": "none",
	"name": "APK Browser Builder",
	"outputFileStrategy": "modules",
	"entryFileName": "REFERENCE.md",
	"includeVersion": true,
	"disableSources": true,
	"cleanOutputDir": true,
	"plugin": ["typedoc-plugin-markdown", "./typedoc-theme.mjs"],
	"theme": "typedoc-theme",
	"sort": ["source-order"],
	"hidePageHeader": true,
	"expandObjects": true,
	"expandParameters": true,
	"typeDeclarationFormat": "htmlTable",
	"propertiesFormat": "htmlTable",
	"parametersFormat": "htmlTable"
}