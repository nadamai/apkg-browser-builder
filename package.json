{
  "name": "apkg-browser-builder",
  "version": "1.0.0",
  "description": "npm package for creating .apkg anki files directly in a browser",
  "keywords": [
    "anki",
    "anki2",
    "apkg",
    "browser",
    "flashcards",
    "spaced-repetition",
    "srs"
  ],
  "author": {
    "name": "Daniel Stasiak",
    "url": "https://digitibox.pl"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.min.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/index.min.js"
    },
    "./dist/*": "./dist/*"
  },
  "bugs": {
    "url": "https://github.com/nadamai/apkg-browser-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadamai/apkg-browser-builder.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "dev": "concurrently --names \"webpack,typedoc\" \"npm:dev:serve\" \"npm:docs:watch\"",
    "dev:serve": "webpack serve --config webpack.dev.cjs",
    "docs": "typedoc --preserveWatchOutput --cleanOutputDir false",
    "docs:watch": "npm run docs -- --watch",
    "prepare": "husky",
    "prepublishOnly": "npm test && npm run build",
    "prettier": "pretty-quick --staged --pattern \"{src,dev,tests}/**/*.ts\" --pattern \"typedoc-theme.mjs\"",
    "prettier:check": "prettier --check \"{src,dev,tests}/**/*.ts\" \"typedoc-theme.mjs\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/copy-webpack-plugin": "^10.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.1",
    "@types/sql.js": "^1.4.11",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^10.0.3",
    "copy-webpack-plugin": "^14.0.0",
    "husky": "^9.1.4",
    "prettier": "^3.8.4",
    "pretty-quick": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "sql.js": "^1.14.1"
  }
}
