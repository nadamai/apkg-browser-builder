{
  "name": "apkg-browser-builder",
  "version": "1.0.0",
  "description": "npm package for creating .apkg anki files in a browser",
  "keywords": [
    "anki",
    "apkg",
    "anki2",
    "anki21"
  ],
  "author": {
    "name": "Daniel Stasiak",
    "url": "https://digitibox.pl"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.min.js",
  "types": "dist/src/builder.d.ts",
  "bugs": {
    "url": "https://github.com/nadamai/apkg-browser-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadamai/apkg-browser-builder.git"
  },
  "license": "MIT",
  "scripts": {
    "prettier": "pretty-quick src/**/*.ts dev/**/*.ts --staged --pattern \"src/**/*.ts\" --pattern \"dev/**/*.ts\"",
    "prepare": "husky",
    "build": "webpack --mode=production --node-env=production",
    "dev": "concurrently \"webpack --mode=production --watch\" \"webpack serve --config webpack.dev.js\""
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@types/concurrently": "^7.0.3",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.1",
    "@types/sql.js": "^1.4.11",
    "@types/webpack-dev-server": "^4.7.2",
    "concurrently": "^10.0.3",
    "file-loader": "^6.2.0",
    "husky": "^9.1.4",
    "prettier": "^3.8.4",
    "pretty-quick": "^4.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260623.1",
    "ts-loader": "^9.6.1",
    "typescript": "^6.0.3",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^5.2.5"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "sql.js": "^1.14.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "_comments": {
    "overrides": {
      "uuid": "Forces uuid to v11+ to fix GHSA-w5hq-g745-h8pq (missing buffer bounds check in v3/v5/v6). sockjs (used by webpack-dev-server) depends on uuid@^8 but only calls uuid.v4() without a buf arg, so v11 is API-compatible. Remove this override once sockjs ships a version that depends on uuid@^11 or when webpack-dev-server drops sockjs."
    }
  }
}
