{
  "name": "apkg-browser-builder",
  "version": "1.0.0",
  "description": "npm package for creating .apkg anki files directly in a browser",
  "keywords": [
    "anki",
    "apkg",
    "anki2",
    "anki21"
  ],
  "author": {
    "name": "Daniel Stasiak",
    "url": "https://digitibox.pl"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.min.js",
  "types": "dist/src/index.d.ts",
  "bugs": {
    "url": "https://github.com/nadamai/apkg-browser-builder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nadamai/apkg-browser-builder.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "webpack",
    "dev": "webpack serve --config webpack.dev.js",
    "prepare": "husky",
    "prettier": "pretty-quick src/**/*.ts dev/**/*.ts tests/**/*.ts --staged --pattern \"src/**/*.ts\" --pattern \"dev/**/*.ts\" --pattern \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.0",
    "@types/sql.js": "^1.4.11",
    "@typescript/native-preview": "^7.0.0-dev.20260624.1",
    "file-loader": "^6.2.0",
    "husky": "^9.1.4",
    "prettier": "^3.8.4",
    "pretty-quick": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "sql.js": "^1.14.1"
  }
}
